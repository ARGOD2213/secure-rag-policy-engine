{
  "family": "policy-rag",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/policy-rag-task-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/policy-rag-task",
  "containerDefinitions": [
    {
      "name": "policy-rag",
      "image": "<replaced-by-ci>",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "AI_PROVIDER", "value": "openai" },
        { "name": "EMBEDDING_DIMENSIONS", "value": "1536" },
        { "name": "DB_URL", "value": "jdbc:postgresql://<RDS_ENDPOINT>:5432/policydocs" },
        { "name": "DB_USERNAME", "value": "policydocs" },
        { "name": "SEED_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:policy-rag/db-password" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:policy-rag/openai-api-key" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:policy-rag/jwt-secret" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fs http://localhost:8080/actuator/health/liveness || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/policy-rag",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
