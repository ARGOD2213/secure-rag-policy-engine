# Copy to terraform.tfvars and adjust.
aws_region   = "ap-south-1" # Mumbai
project_name = "policy-rag"
environment  = "dev"

# OpenRouter (OpenAI-compatible). For OpenAI use https://api.openai.com and drop the "openai/" prefixes.
openai_base_url = "https://openrouter.ai/api"
chat_model      = "openai/gpt-4o-mini"
embedding_model = "openai/text-embedding-3-small"

github_repository = "argod2213/secure-rag-policy-engine"
github_branch     = "main"

# Set to false if your AWS account already has the GitHub OIDC provider.
create_github_oidc_provider = true

# Optional HTTPS: an ACM certificate in the same region.
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/..."
