# --- Model provider: openai | ollama ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBEDDING_DIMENSIONS=1536

# For a free local setup use Ollama instead:
# AI_PROVIDER=ollama
# EMBEDDING_DIMENSIONS=768
# OLLAMA_CHAT_MODEL=llama3.2:3b   # smaller model for laptops with ~8 GB RAM

# --- Security (always override outside local dev) ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
DEMO_PASSWORD=password
# Admin can ingest/delete documents; defaults to DEMO_PASSWORD if unset
ADMIN_PASSWORD=change-me
